//Testbench
module tb_riscv_pipeline;
    logic clk,rst;
    riscv_pipeline dut (.clk(clk),.rst(rst));
    always #5 clk = ~clk;
    initial begin
        $dumpfile("riscv_pipeline.vcd");
        $dumpvars(0, tb_riscv_pipeline);
        clk = 1'b0;
        rst = 1'b1;
        $display("RISC-V PIPELINE SELF CHECKING TEST");
        // Reset
        #20;
        rst = 1'b0;
        // Allow processor to execute
        #250;
        // Register checks
        if (dut.rf.rf[1] == 32'd5)
            $display("PASS: x1 = %0d", dut.rf.rf[1]);
        else
            $display("FAIL: x1 = %0d, expected 5", dut.rf.rf[1]);
        if (dut.rf.rf[2] == 32'd10)
            $display("PASS: x2 = %0d", dut.rf.rf[2]);
        else
            $display("FAIL: x2 = %0d, expected 10", dut.rf.rf[2]);
        if (dut.rf.rf[3] == 32'd15)
            $display("PASS: x3 = %0d", dut.rf.rf[3]);
        else
            $display("FAIL: x3 = %0d, expected 15", dut.rf.rf[3]);
        if (dut.rf.rf[4] == 32'hFFFFFFFB)
            $display("PASS: x4 = %0d", $signed(dut.rf.rf[4]));
        else
            $display("FAIL: x4 = %0d, expected -5",
                     $signed(dut.rf.rf[4]));
        if (dut.rf.rf[5] == 32'd0)
            $display("PASS: x5 = %0d", dut.rf.rf[5]);
        else
            $display("FAIL: x5 = %0d, expected 0", dut.rf.rf[5]);
        if (dut.rf.rf[6] == 32'd15)
            $display("PASS: x6 = %0d", dut.rf.rf[6]);
        else
            $display("FAIL: x6 = %0d, expected 15", dut.rf.rf[6]);
        if (dut.rf.rf[7] == 32'd15)
            $display("PASS: x7 = %0d", dut.rf.rf[7]);
        else
            $display("FAIL: x7 = %0d, expected 15", dut.rf.rf[7]);
        if (dut.rf.rf[8] == 32'd20)
            $display("PASS: x8 = %0d", dut.rf.rf[8]);
        else
            $display("FAIL: x8 = %0d, expected 20", dut.rf.rf[8]);
        // Data memory check
        if (dut.dmem.RAM[0] == 32'd15)
            $display("PASS: MEM[0] = %0d", dut.dmem.RAM[0]);
        else
            $display("FAIL: MEM[0] = %0d, expected 15",
                     dut.dmem.RAM[0]);
        $finish;
    end
    // Pipeline monitoring
    always @(posedge clk) begin
        if (!rst) begin
            $display("TIME=%0t | PC=%h | INSTR=%h | STALL=%b | FWD_A=%b | FWD_B=%b",$time,dut.pc,dut.instr,dut.stall,dut.forward_a,dut.forward_b);
        end
    end
endmodule
